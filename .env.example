# Copy to .env (git-ignored) and fill in.
# VCF Automation host name (no scheme). --host on the command line overrides this.
VCFA_HOST=automation.example.com

# Admin credential for the org you are working in. Either:
#   - an API refresh token (My Account > API Tokens), or
#   - a bearer JWT (starts with eyJ), or
#   - leave both blank and use --admin-user (you will be prompted for the password).
# --admin-token on the command line overrides this.
VCFA_ADMIN_REFRESH_TOKEN=

# Or log in as a user (provider with admin@System, tenant with admin@<org>).
# The password is taken from VCFA_PASSWORD or prompted for.
# VCFA_ADMIN_USER=admin@System
