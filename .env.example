# Copy to .env (git-ignored) and fill in.
VCFA_HOST=automation.example.com
VCFA_ORG=your-org

# Client id of an existing service account, used by token/refresh/login for the default org.
# Not needed for `create`, which stores its own token.
VCFA_CLIENT_ID=

# Org admin API token (My Account > API Tokens). Needed for create, list, and
# automatic approval in login. Treat it as a secret.
VCFA_ADMIN_REFRESH_TOKEN=

# Other orgs: VCFA_ADMIN_REFRESH_TOKEN_<ORG>, e.g. for --org other-org:
# VCFA_ADMIN_REFRESH_TOKEN_OTHER_ORG=
